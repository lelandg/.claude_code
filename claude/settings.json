{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_FORK_SUBAGENT": "1"
  },
  "permissions": {
    "allow": [
      "GitDiff",
      "GitLog",
      "WebSearch",
      "WebFetch",
      "Bash(cat:*)",
      "Bash(cp:*)",
      "Bash(diff:*)",
      "Bash(echo:*)",
      "Bash(env)",
      "Bash(export:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(awk:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(paste:*)",
      "Bash(sha256sum:*)",
      "Bash(source:*)",
      "Bash(tail:*)",
      "Bash(test:*)",
      "Bash(tree:*)",
      "Bash(unzip:*)",
      "Bash(unset:*)",
      "Bash(wc:*)",
      "Bash(xargs:*)",
      "Bash(zip:*)",
      "Bash(curl:*)",
      "Bash(dig:*)",
      "Bash(lsof:*)",
      "Bash(netstat:*)",
      "Bash(pgrep:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(git add:*)",
      "Bash(git check-ignore:*)",
      "Bash(git checkout:*)",
      "Bash(git clone:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(git status:*)",
      "Bash(git worktree:*)",
      "Bash(git -C:*)",
      "Bash(git:*)",
      "Bash(gh api:*)",
      "Bash(gh issue:*)",
      "Bash(gh label:*)",
      "Bash(gh pr:*)",
      "Bash(gh project:*)",
      "Bash(gh repo:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(pip show:*)",
      "Bash(python3:*)",
      "Bash(node -e:*)",
      "Bash(npm install:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run type-check:*)",
      "Bash(npm test:*)",
      "Bash(npm ls:*)",
      "Bash(npx tsc:*)",
      "Bash(npx:*)",
      "Bash(dotnet list package:*)",
      "Bash(psql:*)",
      "Bash(sqlite3:*)",
      "Bash(openssl rand:*)",
      "Bash(openssl dgst:*)",
      "Bash(identify:*)",
      "Skill(superpowers:brainstorming)",
      "Skill(brainstorming)",
      "Skill(commit-commands:commit)",
      "Read(//home/<YOUR_USER>/.claude/**)",
      "Read(//usr/bin/**)",
      "Bash(aws sts get-caller-identity:*)",
      "Bash(aws logs tail:*)",
      "Bash(aws s3 ls:*)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "acceptEdits"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": false,
    "explanatory-output-style@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": false,
    "learning-output-style@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "example-skills@anthropic-agent-skills": true,
    "github@claude-plugins-official": true,
    "serena@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "huggingface-skills@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "gitlab@claude-plugins-official": false,
    "playground@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "blueprint@owainlewis-blueprint": false,
    "codex@openai-codex": true,
    "claude-code-setup@claude-plugins-official": true,
    "cli-anything@cli-anything": true,
    "remember@claude-plugins-official": true,
    "atomic-agents@claude-plugins-official": true,
    "mintlify@claude-plugins-official": true,
    "session-report@claude-plugins-official": true,
    "discord@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true,
    "databases-on-aws@claude-plugins-official": false,
    "aws-amplify@claude-plugins-official": true,
    "aws-dev-toolkit@claude-plugins-official": true,
    "adobe-for-creativity@claude-plugins-official": true,
    "aws-core@claude-plugins-official": false,
    "aws-agents@claude-plugins-official": false,
    "obsidian-cli@obsidian-cli-skill": true,
    "hookify@claude-plugins-official": true,
    "canva@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "owainlewis-blueprint": {
      "source": {
        "source": "github",
        "repo": "owainlewis/blueprint"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "cli-anything": {
      "source": {
        "source": "github",
        "repo": "HKUDS/CLI-Anything"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "obsidian-cli-skill": {
      "source": {
        "source": "git",
        "url": "https://github.com/pablo-mano/Obsidian-CLI-skill.git"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "default",
  "preferredNotifChannel": "terminal_bell",
  "teammateMode": "in-process",
  "installMethod": "native",
  "agentPushNotifEnabled": true,
  "awaySummaryEnabled": false,
  "inputNeededNotifEnabled": true,
  "verbose": true,
  "worktree": {
    "baseRef": "fresh"
  }
}
